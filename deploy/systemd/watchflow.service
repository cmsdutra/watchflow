[Unit]
Description=WatchFlow — Filesystem-driven autonomous Git automation daemon
Documentation=https://github.com/watchflow/watchflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/watchflow start
ExecStop=%h/.local/bin/watchflow stop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
KillMode=mixed
KillSignal=SIGTERM

# Hardening e segurança na sessão do usuário.
# ProtectKernelModules= é omitido de propósito: em uma unidade de usuário ele
# implica derrubar CAP_SYS_MODULE do bounding set, o que exige CAP_SETPCAP e
# falha com 218/CAPABILITIES em kernels que restringem user namespaces sem
# privilégio (Ubuntu 24.04+ com AppArmor).
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes

[Install]
WantedBy=default.target
